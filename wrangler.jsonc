{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chicken-gun-online",
  "main": "./worker.js",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "GameLobby" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom", "GameLobby"]
    }
  ]
}
